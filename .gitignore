# Môi trường Python
.venv/
.venv_models/

# Trọng số model (YOLO/SAM) — lớn, không commit
*.pt
*.pth
*.onnx
__pycache__/
*.pyc

# Secrets / token (không bao giờ commit)
.streamlit/secrets.toml
.env
.env.*
*.pem
*.key

# File tạm của hệ điều hành / Office
Thumbs.db
.DS_Store
~$*

# ---- Dữ liệu local, KHÔNG commit ----
# Bản sao ZIP pilot (~170 MB, chứa overlay/mask sinh từ ảnh BDD100K)
data/real/local/
# Mọi file nén, ảnh và mask trong data/ (chỉ giữ local; không đưa toàn bộ BDD100K lên repo)
data/**/*.zip
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
# Ngoại lệ: 200 ảnh preview của đúng 100 ảnh pilot cho tab ③ (giấy phép: data/real/pilot_images/LICENSE_BDD100K.md)
!data/real/pilot_images/detection/*.jpg
!data/real/pilot_images/segmentation/*.jpg

# CSV pilot đã xử lý (đặc trưng pre-label, kết quả phân tích tổng hợp) ĐƯỢC commit để app chạy ngay.
# Đã rà soát 2026-10-18: không có đường dẫn máy, email hay tên người; image_id là mã công khai của BDD100K.
#
# Correction log thật: nhóm đã xác nhận đồng ý công khai ngày 2026-10-18; được commit để app đối chiếu.

# Benchmark YOLO/SAM: chỉ commit 4 file tổng hợp mà tab ⑥ đọc (không image_id, không toạ độ).
# File theo từng ảnh (detections_*.csv, per_image_results.csv, sam_eval_image_sets.csv, ...) giữ local.
data/real/model_comparison/*
!data/real/model_comparison/runs/
data/real/model_comparison/runs/*/*
!data/real/model_comparison/runs/*/run_config.json
!data/real/model_comparison/runs/*/detection_summary.json
!data/real/model_comparison/runs/*/segmentation_summary.json
!data/real/model_comparison/runs/*/sam_eval_recomputed.csv
